				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "275d7742-8b73-47b6-8aa3-c03df28eb084")
	)
	(text_box "BQ25703A hardware configuration:\n- ILIM_HIZ pin set to 1.2V.\n- CELL_BATTPRESZ set to 55% of VDDA.\nInput current limit to be deactivated by MCU via I2C when PD negocation succeed."
		(exclude_from_sim no)
		(at 203.2 91.44 0)
		(size 60.96 12.7)
